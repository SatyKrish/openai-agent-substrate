{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "document-test",
    "namespace": "openai-agent-substrate",
    "labels": {
      "app.kubernetes.io/name": "openai-agent-substrate",
      "app.kubernetes.io/component": "harness"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 1800,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "openai-agent-substrate",
          "app.kubernetes.io/component": "harness"
        }
      },
      "spec": {
        "serviceAccountName": "openai-agent",
        "restartPolicy": "Never",
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "runAsGroup": 10001,
          "fsGroup": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "agent",
            "image": "registry.example/harness@sha256:abc",
            "imagePullPolicy": "IfNotPresent",
            "envFrom": [
              {
                "configMapRef": {
                  "name": "openai-agent-tracing",
                  "optional": true
                }
              },
              {
                "secretRef": {
                  "name": "openai-agent-env"
                }
              }
            ],
            "env": [
              {
                "name": "SUBSTRATE_TEMPLATE",
                "value": "python-template"
              },
              {
                "name": "SUBSTRATE_ATESPACE",
                "value": "ate-demo-sandbox"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "agent-config",
                "mountPath": "/var/run/agent-config",
                "readOnly": true
              },
              {
                "name": "kubeconfig",
                "mountPath": "/etc/agent",
                "readOnly": true
              },
              {
                "name": "substrate",
                "mountPath": "/var/run/substrate",
                "readOnly": true
              },
              {
                "name": "artifacts",
                "mountPath": "/artifacts"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ],
            "args": [
              "--test"
            ]
          }
        ],
        "volumes": [
          {
            "name": "agent-config",
            "secret": {
              "secretName": "openai-agent-env",
              "defaultMode": 288
            }
          },
          {
            "name": "kubeconfig",
            "configMap": {
              "name": "openai-agent-kubeconfig"
            }
          },
          {
            "name": "substrate",
            "projected": {
              "sources": [
                {
                  "serviceAccountToken": {
                    "audience": "api.ate-system.svc",
                    "expirationSeconds": 3600,
                    "path": "api-token"
                  }
                },
                {
                  "podCertificate": {
                    "signerName": "podidentity.podcert.ate.dev/identity",
                    "keyType": "ECDSAP256",
                    "credentialBundlePath": "credential-bundle.pem"
                  }
                },
                {
                  "clusterTrustBundle": {
                    "signerName": "servicedns.podcert.ate.dev/identity",
                    "path": "router-ca.pem",
                    "labelSelector": {
                      "matchLabels": {
                        "podcert.ate.dev/canarying": "live"
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "name": "artifacts",
            "persistentVolumeClaim": {
              "claimName": "openai-agent-artifacts"
            }
          },
          {
            "name": "tmp",
            "emptyDir": {}
          }
        ]
      }
    }
  }
}
