{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "jaeger-all-in-one",
        "namespace": "openai-agent-substrate"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "jaeger-all-in-one"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "jaeger-all-in-one"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "jaeger",
                "image": "jaegertracing/all-in-one:1.76.0@sha256:ab6f1a1f0fb49ea08bcd19f6b84f6081d0d44b364b6de148e1798eb5816bacac",
                "env": [
                  {
                    "name": "COLLECTOR_OTLP_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "SPAN_STORAGE_TYPE",
                    "value": "memory"
                  },
                  {
                    "name": "MEMORY_MAX_TRACES",
                    "value": "1000"
                  }
                ],
                "ports": [
                  {
                    "name": "otlp-http",
                    "containerPort": 4318
                  },
                  {
                    "name": "query",
                    "containerPort": 16686
                  },
                  {
                    "name": "admin",
                    "containerPort": 14269
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": "admin"
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "jaeger-all-in-one",
        "namespace": "openai-agent-substrate"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "jaeger-all-in-one"
        },
        "ports": [
          {
            "name": "otlp-http",
            "port": 4318,
            "targetPort": "otlp-http"
          },
          {
            "name": "query",
            "port": 16686,
            "targetPort": "query"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "openai-agent-tracing",
        "namespace": "openai-agent-substrate"
      },
      "data": {
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger-all-in-one.openai-agent-substrate.svc:4318",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
        "OTEL_SERVICE_NAME": "openai-agent-substrate"
      }
    }
  ]
}
