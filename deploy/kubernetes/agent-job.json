{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "openai-agent",
    "namespace": "openai-agent-substrate",
    "labels": {"app.kubernetes.io/name": "openai-agent-substrate", "app.kubernetes.io/component": "harness"}
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 1800,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "metadata": {"labels": {"app.kubernetes.io/name": "openai-agent-substrate", "app.kubernetes.io/component": "harness"}},
      "spec": {
        "serviceAccountName": "openai-agent",
        "restartPolicy": "Never",
        "securityContext": {"runAsNonRoot": true, "runAsUser": 10001, "runAsGroup": 10001, "fsGroup": 10001, "seccompProfile": {"type": "RuntimeDefault"}},
        "containers": [{
          "name": "agent",
          "image": "REPLACED_BY_SETUP_WITH_IMAGE_DIGEST",
          "imagePullPolicy": "IfNotPresent",
          "envFrom": [{"secretRef": {"name": "openai-agent-env"}}],
          "env": [{"name": "SUBSTRATE_TEMPLATE", "value": "REPLACED_WITH_PYTHON_ACTOR_TEMPLATE"}],
          "securityContext": {"allowPrivilegeEscalation": false, "readOnlyRootFilesystem": true, "capabilities": {"drop": ["ALL"]}},
          "resources": {"requests": {"cpu": "100m", "memory": "256Mi"}, "limits": {"cpu": "1", "memory": "1Gi"}},
          "volumeMounts": [
            {"name": "agent-config", "mountPath": "/var/run/agent-config", "readOnly": true},
            {"name": "kubeconfig", "mountPath": "/etc/agent", "readOnly": true},
            {"name": "artifacts", "mountPath": "/artifacts"},
            {"name": "tmp", "mountPath": "/tmp"}
          ]
        }],
        "volumes": [
          {"name": "agent-config", "secret": {"secretName": "openai-agent-env", "defaultMode": 288}},
          {"name": "kubeconfig", "configMap": {"name": "openai-agent-kubeconfig"}},
          {"name": "artifacts", "persistentVolumeClaim": {"claimName": "openai-agent-artifacts"}},
          {"name": "tmp", "emptyDir": {}}
        ]
      }
    }
  }
}
