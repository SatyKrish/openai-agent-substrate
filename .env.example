# Copy to .env and replace the empty key. Use plain KEY=VALUE, without shell
# export statements, quotes, or variable interpolation (kubectl env-file syntax).
# Only the trusted harness reads it: the agent UIs on this host and the agent Job's
# pod. Sandboxes never receive these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra

# Optional OTLP tracing (install local Jaeger with ./scripts/local-kubernetes.sh tracing-setup).
# The Kubernetes ConfigMap created by tracing-setup supplies these defaults.
# Explicit .env values take precedence. OTLP HTTP/protobuf only (port 4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-all-in-one.openai-agent-substrate.svc:4318
# OTEL_SERVICE_NAME=openai-agent-substrate
# OPENAI_AGENTS_DISABLE_TRACING=1

# Optional OpenAI account routing:
# OPENAI_ORG_ID=org-your-organization
# OPENAI_PROJECT_ID=proj_your-project
