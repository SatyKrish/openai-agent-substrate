# Copy to .env and replace the empty key. Use plain KEY=VALUE, without shell
# export statements, quotes, or variable interpolation (kubectl env-file syntax).
# This configuration is mounted only into the trusted agent harness pod.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra

# Optional OpenAI account routing:
# OPENAI_ORG_ID=org-your-organization
# OPENAI_PROJECT_ID=proj_your-project
