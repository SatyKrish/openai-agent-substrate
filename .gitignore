# Python bytecode and package build output. pytest, ruff and mypy caches ignore
# themselves with their own .gitignore.
__pycache__/
*.egg-info/
build/
dist/

# uv writes its own .gitignore here; this covers a venv made another way.
.venv/

# Local cluster state, credentials, conversations and logs.
artifacts/

# Settings with secrets; only the example is tracked.
.env
.env.*
!.env.example

.DS_Store
